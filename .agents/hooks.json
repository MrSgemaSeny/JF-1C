{
  "enforce-workflow": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/enforce-workflow.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "reminder": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/reminder.ps1",
        "timeout": 10
      }
    ]
  }
}
